<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveTotalsHelper.App.ViewModels"
        xmlns:models="using:LiveTotalsHelper.Core.Models"
        x:Class="LiveTotalsHelper.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Live O/U Helper"
        Width="1220"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox.input">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,1,6,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox.input">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,1,6,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.wide-input">
      <Setter Property="Width" Value="265" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,1,6,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.positive">
      <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*" Margin="8">

    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="panel" Padding="8,6">
      <Grid ColumnDefinitions="Auto,190,Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="League" Classes="label" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Leagues}" SelectedItem="{Binding LeagueFilter}" Height="28" />
        <Button Grid.Column="2" Classes="compact" Content="Load fixtures" Click="LoadFixtures_Click" />
        <TextBlock Grid.Column="3" Text="{Binding ProfileNotes}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding LiveStatus}" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="panel" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Fixtures from DB" Classes="section-title" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:MatchSnapshot">
              <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
                <Grid ColumnDefinitions="32,*,40" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.RowSpan="2" Text="{Binding MinuteText}" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding HomeTeam}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Score}" FontSize="12" HorizontalAlignment="Center" FontWeight="Bold" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AwayTeam}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BestSignal}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">

      <Border Grid.Row="0" Classes="panel">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
          <StackPanel>
            <TextBlock Text="{Binding SelectedMatchTitle}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="compact" Content="Price" Click="BuildCheck_Click" />
          <Button Grid.Column="2" Classes="compact" Content="Log bet" Click="LogBet_Click" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
          <StackPanel Grid.Row="0">
            <TextBlock Text="State" Classes="section-title" />
            <WrapPanel>
              <StackPanel>
                <TextBlock Text="Trigger" Classes="label" />
                <ComboBox x:Name="StateTriggerBox" Width="126" Height="28" FontSize="12" ItemsSource="{Binding StateTriggers}" SelectedItem="{Binding LiveInput.StateTrigger}" />
              </StackPanel>
              <StackPanel><TextBlock Text="Min" Classes="label" /><ComboBox x:Name="MinuteBox" Classes="input" ItemsSource="{Binding Minutes}" SelectedItem="{Binding LiveInput.Minute}" /></StackPanel>
              <StackPanel><TextBlock Text="HG" Classes="label" /><ComboBox x:Name="HomeGoalsBox" Classes="input" ItemsSource="{Binding GoalCounts}" SelectedItem="{Binding LiveInput.HomeGoals}" /></StackPanel>
              <StackPanel><TextBlock Text="AG" Classes="label" /><ComboBox x:Name="AwayGoalsBox" Classes="input" ItemsSource="{Binding GoalCounts}" SelectedItem="{Binding LiveInput.AwayGoals}" /></StackPanel>
              <StackPanel><TextBlock Text="HR" Classes="label" /><ComboBox x:Name="HomeRedCardsBox" Classes="input" ItemsSource="{Binding RedCardCounts}" SelectedItem="{Binding LiveInput.HomeRedCards}" /></StackPanel>
              <StackPanel><TextBlock Text="AR" Classes="label" /><ComboBox x:Name="AwayRedCardsBox" Classes="input" ItemsSource="{Binding RedCardCounts}" SelectedItem="{Binding LiveInput.AwayRedCards}" /></StackPanel>
              <StackPanel><TextBlock Text="LastG" Classes="label" /><ComboBox x:Name="LastGoalMinuteBox" Classes="input" ItemsSource="{Binding LastGoalMinuteOptions}" SelectedItem="{Binding LiveInput.LastGoalMinute}" /></StackPanel>
              <StackPanel><TextBlock Text="Round" Classes="label" /><TextBox x:Name="BeforeRoundBox" Classes="input" Text="{Binding LiveInput.BeforeRound, Mode=OneWay}" Watermark="opt" /></StackPanel>
            </WrapPanel>
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Starting total" Classes="section-title" />
              <Grid ColumnDefinitions="52,76,76,90" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Line" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Over" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Under" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Targets" Classes="label" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="2.5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="StartingOverOdds25Box" Grid.Row="1" Grid.Column="1" Classes="input" Text="{Binding LiveInput.StartingOverOdds25, Mode=OneWay}" />
                <TextBox x:Name="StartingUnderOdds25Box" Grid.Row="1" Grid.Column="2" Classes="input" Text="{Binding LiveInput.StartingUnderOdds25, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LiveInput.TargetLinesText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="3.5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="StartingOverOdds35Box" Grid.Row="2" Grid.Column="1" Classes="input" Text="{Binding LiveInput.StartingOverOdds35, Mode=OneWay}" />
                <TextBox x:Name="StartingUnderOdds35Box" Grid.Row="2" Grid.Column="2" Classes="input" Text="{Binding LiveInput.StartingUnderOdds35, Mode=OneWay}" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="Live odds" Classes="section-title" />
              <Grid ColumnDefinitions="52,76,76" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Line" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Over" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Under" Classes="label" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="2.5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="LiveOverOdds25Box" Grid.Row="1" Grid.Column="1" Classes="input" Text="{Binding LiveInput.LiveOverOdds25, Mode=OneWay}" />
                <TextBox x:Name="LiveUnderOdds25Box" Grid.Row="1" Grid.Column="2" Classes="input" Text="{Binding LiveInput.LiveUnderOdds25, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="3.5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="LiveOverOdds35Box" Grid.Row="2" Grid.Column="1" Classes="input" Text="{Binding LiveInput.LiveOverOdds35, Mode=OneWay}" />
                <TextBox x:Name="LiveUnderOdds35Box" Grid.Row="2" Grid.Column="2" Classes="input" Text="{Binding LiveInput.LiveUnderOdds35, Mode=OneWay}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="panel">
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="2">
          <TextBlock Grid.Row="0" Text="Model" Classes="label" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelSummaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />

          <TextBlock Grid.Row="1" Text="Rules" Classes="label" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DecisionRulesText}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" />

          <TextBlock Grid.Row="2" Text="Warnings" Classes="label" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Warnings}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" />

          <TextBlock Grid.Row="3" Text="State corr." Classes="label" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateCorrectionText}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" />

          <TextBlock Grid.Row="4" Text="Volume" Classes="label" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VolumeText}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" />
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,260" ColumnSpacing="6">
        <Border Grid.Column="0" Classes="panel">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="45,55,58,58,58,70,62,70,150,*" Margin="0,0,0,4">
              <TextBlock Text="Line" Classes="label" />
              <TextBlock Grid.Column="1" Text="Side" Classes="label" />
              <TextBlock Grid.Column="2" Text="BaseO" Classes="label" />
              <TextBlock Grid.Column="3" Text="CorrO" Classes="label" />
              <TextBlock Grid.Column="4" Text="Move" Classes="label" />
              <TextBlock Grid.Column="5" Text="Book" Classes="label" />
              <TextBlock Grid.Column="6" Text="Edge" Classes="label" />
              <TextBlock Grid.Column="7" Text="Fair" Classes="label" />
              <TextBlock Grid.Column="8" Text="Decision" Classes="label" />
              <TextBlock Grid.Column="9" Text="Reason" Classes="label" />
            </Grid>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding LiveDecisions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:LiveBettingDecisionRow">
                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                      <Grid ColumnDefinitions="45,55,58,58,58,70,62,70,150,*">
                        <TextBlock Text="{Binding LineText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Side}" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding BaseOverText}" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{Binding CorrOverText}" FontSize="12" />
                        <TextBlock Grid.Column="4" Text="{Binding ProbabilityMoveText}" FontSize="12" Classes="positive" />
                        <TextBlock Grid.Column="5" Text="{Binding BookOddsText}" FontSize="12" />
                        <TextBlock Grid.Column="6" Text="{Binding EdgeText}" FontSize="12" Classes="positive" />
                        <TextBlock Grid.Column="7" Text="{Binding FairOddsText}" FontSize="12" />
                        <TextBlock Grid.Column="8" Text="{Binding Decision}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="9" Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel">
          <StackPanel>
            <TextBlock Text="Log selected bet" Classes="section-title" />
            <WrapPanel>
              <StackPanel><TextBlock Text="Line" Classes="label" /><ComboBox x:Name="SelectedBetLineBox" Classes="input" ItemsSource="{Binding TotalLines}" SelectedItem="{Binding LiveInput.SelectedBetLine}" /></StackPanel>
              <StackPanel>
                <TextBlock Text="Side" Classes="label" />
                <ComboBox x:Name="SelectedBetSideBox" Width="80" Height="28" FontSize="12" ItemsSource="{Binding BetSides}" SelectedItem="{Binding LiveInput.SelectedBetSide}" />
              </StackPanel>
              <StackPanel><TextBlock Text="Odds" Classes="label" /><TextBox x:Name="SelectedBetOddsBox" Classes="input" Text="{Binding LiveInput.SelectedBetOdds, Mode=OneWay}" /></StackPanel>
              <StackPanel><TextBlock Text="Stake" Classes="label" /><TextBox x:Name="StakeBox" Classes="input" Text="{Binding LiveInput.Stake, Mode=OneWay}" /></StackPanel>
              <StackPanel>
                <TextBlock Text="Mode" Classes="label" />
                <ComboBox x:Name="BetModeBox" Width="78" Height="28" FontSize="12" ItemsSource="{Binding BetModes}" SelectedItem="{Binding LiveInput.BetMode}" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="Notes" Classes="label" Margin="0,4,0,0" />
            <TextBox x:Name="BetNotesBox" Text="{Binding LiveInput.BetNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" FontSize="12" />
            <TextBlock Text="Log file" Classes="label" Margin="0,6,0,0" />
            <TextBlock Text="{Binding PaperLogPath}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

    </Grid>
  </Grid>
</Window>
