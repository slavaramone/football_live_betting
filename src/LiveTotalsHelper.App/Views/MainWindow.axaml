<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveTotalsHelper.App.ViewModels"
        xmlns:models="using:LiveTotalsHelper.Core.Models"
        x:Class="LiveTotalsHelper.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Live O/U Paper Betting Helper"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        Background="{StaticResource AppBgBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.input">
      <Setter Property="Width" Value="86" />
      <Setter Property="Margin" Value="0,4,12,0" />
    </Style>
    <Style Selector="TextBox.wide-input">
      <Setter Property="Width" Value="360" />
      <Setter Property="Margin" Value="0,4,12,0" />
    </Style>
    <Style Selector="TextBlock.positive">
      <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="320,*" Margin="16">

    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="panel" Padding="14,10" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="{Binding AppTitle}" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Select league, choose DB fixture, enter live odds, price directly in-app, then log checks/bets." Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Spacing="8">
          <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="panel" Margin="0,0,14,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="League" Classes="label" />
          <ComboBox ItemsSource="{Binding Leagues}" SelectedItem="{Binding LeagueFilter}" Width="270" />
          <TextBlock Text="{Binding ProfileNotes}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="DB fixtures" Classes="section-title" Margin="0,18,0,8" />

        <ListBox Grid.Row="2" ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:MatchSnapshot">
              <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                <Grid ColumnDefinitions="42,*,44,76" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.RowSpan="2" Text="{Binding MinuteText}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding HomeTeam}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Score}" HorizontalAlignment="Center" FontWeight="Bold" />
                  <TextBlock Grid.Column="3" Text="{Binding EdgeText}" Classes="positive" HorizontalAlignment="Right" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AwayTeam}" Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding BestSignal}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel>

        <Border Classes="panel">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="Live betting check" Classes="section-title" />
              <TextBlock Text="{Binding SelectedMatchTitle}" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Price live total" Click="BuildCheck_Click" Padding="16,8" />
            <Button Grid.Column="2" Content="Append paper log" Click="AppendPaperLog_Click" Padding="16,8" />
            <Button Grid.Column="3" Content="Log bet" Click="LogBet_Click" Padding="16,8" />
          </Grid>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="1. Trigger and match state" Classes="section-title" />

            <WrapPanel Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Trigger" Classes="label" />
                <ComboBox Width="150" ItemsSource="{Binding StateTriggers}" SelectedItem="{Binding LiveInput.StateTrigger}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Minute" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.Minute}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Home goals" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.HomeGoals}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Away goals" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.AwayGoals}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Home reds" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.HomeRedCards}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Away reds" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.AwayRedCards}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Last goal min" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.LastGoalMinute}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Before round" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.BeforeRound}" Watermark="optional" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="2. Starting market and current live odds" Classes="section-title" />

            <TextBlock Text="Starting/pre-match total" Classes="label" />
            <WrapPanel Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Line" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.StartingLine}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Over" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.StartingOverOdds}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Under" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.StartingUnderOdds}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Target lines" Classes="label" />
                <TextBox Classes="wide-input" Text="{Binding LiveInput.TargetLinesText}" />
              </StackPanel>
            </WrapPanel>

            <TextBlock Text="Live odds format: 2.5=2.30,3.5=4.20" Classes="label" />
            <WrapPanel>
              <StackPanel>
                <TextBlock Text="Live over odds" Classes="label" />
                <TextBox Classes="wide-input" Text="{Binding LiveInput.LiveOverOddsText}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Live under odds" Classes="label" />
                <TextBox Classes="wide-input" Text="{Binding LiveInput.LiveUnderOddsText}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="3. Direct pricing result" Classes="section-title" />
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="Status" Classes="label" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LiveStatus}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />

              <TextBlock Grid.Row="1" Text="Model" Classes="label" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelSummaryText}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="2" Text="State correction" Classes="label" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StateCorrectionText}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="3" Text="Volume factor" Classes="label" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VolumeText}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="4" Text="Warnings" Classes="label" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Warnings}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="5" Text="Log path" Classes="label" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PaperLogPath}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="4. Pricing table" Classes="section-title" />
            <Grid ColumnDefinitions="60,80,90,100,90,110,*" Margin="0,0,0,6">
              <TextBlock Text="Line" Classes="label" />
              <TextBlock Grid.Column="1" Text="Side" Classes="label" />
              <TextBlock Grid.Column="2" Text="Book" Classes="label" />
              <TextBlock Grid.Column="3" Text="Model %" Classes="label" />
              <TextBlock Grid.Column="4" Text="Fair" Classes="label" />
              <TextBlock Grid.Column="5" Text="Edge" Classes="label" />
              <TextBlock Grid.Column="6" Text="Decision" Classes="label" />
            </Grid>
            <ItemsControl ItemsSource="{Binding LiveDecisions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:LiveBettingDecisionRow">
                  <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid ColumnDefinitions="60,80,90,100,90,110,*">
                      <TextBlock Text="{Binding LineText}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Side}" />
                      <TextBlock Grid.Column="2" Text="{Binding BookOddsText}" />
                      <TextBlock Grid.Column="3" Text="{Binding ModelProbabilityText}" />
                      <TextBlock Grid.Column="4" Text="{Binding FairOddsText}" />
                      <TextBlock Grid.Column="5" Text="{Binding EdgeText}" Classes="positive" />
                      <TextBlock Grid.Column="6" Text="{Binding Decision}" FontWeight="Bold" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="5. Log selected bet" Classes="section-title" />
            <WrapPanel Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Line" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.SelectedBetLineText}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Side" Classes="label" />
                <ComboBox Width="110" ItemsSource="{Binding BetSides}" SelectedItem="{Binding LiveInput.SelectedBetSide}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Odds" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.SelectedBetOdds}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Stake" Classes="label" />
                <TextBox Classes="input" Text="{Binding LiveInput.Stake}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Mode" Classes="label" />
                <ComboBox Width="110" ItemsSource="{Binding BetModes}" SelectedItem="{Binding LiveInput.BetMode}" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="Bet notes" Classes="label" />
            <TextBox Text="{Binding LiveInput.BetNotes}" AcceptsReturn="True" Height="54" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
